# Copiez ce fichier en « .env » (à la racine du dépôt) puis remplacez les valeurs.
# Les vraies valeurs vous sont données par l'enseignant. Ne committez JAMAIS le fichier .env.

# --- PostgreSQL (Supabase) : base « gestion scolaire » ---
# Utilisez l'hôte du pooler Supabase (IPv4) en mode « transaction » (port 6543),
# pas db.<projet>.supabase.co (IPv6 uniquement) ni le mode session (5432, limité à 15 clients).
# Recopiez l'hôte exact donné par l'enseignant : le préfixe (aws-0 ou aws-1) et la région varient d'un projet à l'autre.
PG_HOST=aws-<N>-<region>.pooler.supabase.com
PG_PORT=6543
PG_DATABASE=postgres
PG_USER=postgres.<identifiant-projet>
PG_PASSWORD=<mot-de-passe>

# --- MongoDB Atlas : base « ride share » ---
MONGO_URI=mongodb+srv://<utilisateur>:<mot-de-passe>@<cluster>.mongodb.net/?appName=<app>
MONGO_DB=ride_share_v1
